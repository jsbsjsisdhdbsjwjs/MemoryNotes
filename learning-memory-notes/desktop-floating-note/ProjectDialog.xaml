<Window x:Class="MemoryNotesFloating.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增学习项目"
        Width="320"
        Height="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="项目名称" Foreground="#647086" />
    <TextBox x:Name="NameBox" Grid.Row="1" Height="34" Margin="0,8,0,12" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Width="72" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button Content="添加" Width="72" Click="Ok_Click" />
    </StackPanel>
  </Grid>
</Window>
