<Window x:Class="MemoryNotesFloating.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Notes Floating"
        Width="420"
        Height="560"
        MinWidth="360"
        MinHeight="420"
        WindowStartupLocation="Manual"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Background="#00FFFFFF"
        AllowsTransparency="True"
        WindowStyle="None">
  <Border Background="#FFFFFFFF"
          BorderBrush="#DCE3EE"
          BorderThickness="1"
          CornerRadius="8"
          SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border x:Name="TitleBar"
              Grid.Row="0"
              Background="#172033"
              CornerRadius="8,8,0,0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <DockPanel LastChildFill="False" Margin="14,0">
          <TextBlock Text="快速学习笔记"
                     Foreground="White"
                     FontSize="15"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     DockPanel.Dock="Left" />
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
            <Button x:Name="PinButton"
                    Content="置顶"
                    Click="PinButton_Click"
                    Width="54"
                    Height="28"
                    Margin="0,0,8,0" />
            <Button Content="×"
                    Click="CloseButton_Click"
                    Width="30"
                    Height="28" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="110" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
          <TextBlock Text="学习项目" Foreground="#647086" FontSize="12" Margin="0,0,0,4" />
          <DockPanel>
            <ComboBox x:Name="ProjectCombo"
                      MinHeight="34"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectionChanged="ProjectCombo_SelectionChanged" />
            <Button Content="新增"
                    Width="58"
                    Margin="8,0,0,0"
                    Click="AddProjectButton_Click" />
          </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <TextBlock Text="笔记内容" Foreground="#647086" FontSize="12" Margin="0,0,0,4" />
          <TextBox x:Name="NoteText"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   MinHeight="180"
                   FontSize="14" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
          <TextBlock Text="标签，用逗号分隔" Foreground="#647086" FontSize="12" Margin="0,0,0,4" />
          <TextBox x:Name="TagsText" MinHeight="34" />
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,12,0,10">
          <TextBlock x:Name="StatusText"
                     Foreground="#0F8F72"
                     VerticalAlignment="Center"
                     DockPanel.Dock="Left" />
          <Button Content="保存笔记"
                  Width="96"
                  Height="36"
                  DockPanel.Dock="Right"
                  Click="SaveButton_Click" />
        </DockPanel>

        <Border Grid.Row="4"
                BorderBrush="#DCE3EE"
                BorderThickness="1"
                CornerRadius="6"
                Background="#FBFDFF">
          <ListBox x:Name="RecentList"
                   BorderThickness="0"
                   Background="Transparent" />
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
